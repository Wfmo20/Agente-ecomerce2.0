      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Mensaje para el agente').item.json.chat_id }}",
        "text": "={{ $('Mensaje para el agente').item.json.prefijo + 'Tuve un problema para responderte. Intenta de nuevo en unos segundos (si es un audio, que sea corto y claro).' }}",
        "additionalFields": {
