# Copia este archivo como .env y completa los valores. Nunca subas el .env ni pongas claves en el código.
# Clave de Gemini
GOOGLE_API_KEY=
MODELO=gemini-3.5-flash-lite
# Clave que deben enviar los clientes de /chat en la cabecera X-API-Key (inventa una larga; vacía = /chat rechaza todo)
API_KEY=
# Lo da BotFather en Telegram
TELEGRAM_TOKEN=
# Secreto que Telegram manda en cada webhook para que la API lo verifique
TELEGRAM_SECRET=cambiame
# chat_id de Telegram autorizados, separados por coma (el bot le dice su chat_id a quien no está autorizado)
TELEGRAM_ALLOWED_IDS=
# URL https pública (la de Render; vacío hasta desplegar)
PUBLIC_URL=
